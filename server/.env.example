# Server-side key with Geolocation API and Places API (New) enabled.
# Restrict it by API and by server IP in Google Cloud Console; never ship it to clients.
GOOGLE_MAPS_API_KEY=
# Optional. Local port for `npm run dev`; defaults to 4000, next to the Next.js site on 3000.
# Leave unset when using `vercel dev`, which assigns the port itself.
# PORT=4000
# Requests per IP per minute across /api routes.
RATE_LIMIT_PER_MINUTE=60
# How long identical spot searches are served from memory.
CACHE_TTL_SECONDS=300
# Optional. Gemini key from Google AI Studio for /api/recommendations ranking.
# Leave empty to use the nearest-open fallback instead.
GEMINI_API_KEY=
# Model id without the "models/" prefix. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
# Photon Spectrum project (app.photon.codes > Settings). With both set, the agent
# answers on iMessage; without them `npm run agent` opens a local terminal chat.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Also open the terminal chat when iMessage is on.
AGENT_TERMINAL=
# Which fan the terminal chat acts as. Defaults to the seed demo fan.
AGENT_TERMINAL_HANDLE=
# Hours before kickoff to text reminders, and how often to check.
REMINDER_HOURS=24,2
REMINDER_CHECK_SECONDS=60
# The Huddle iMessage number (from the Photon dashboard), shown after website sign-up.
HUDDLE_NUMBER=
# "dedicated" on Photon's Business plan (fans are registered to HUDDLE_NUMBER); default "shared".
SPECTRUM_USER_TYPE=
# Shared storage (Upstash Redis via Vercel Marketplace). Set the same values on
# Vercel and here so the website and the iMessage agent see the same fans,
# events and queue. Without them each uses its own local file.
KV_REST_API_URL=
KV_REST_API_TOKEN=
