{
  "name": "huddle-server",
  "version": "1.0.0",
  "description": "Huddle backend and iMessage agent: nearby watch spots, game sign-ups, reminders",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "tsc",
    "start": "node dist/src/local.js",
    "agent": "tsx src/agent/index.ts",
    "agent:start": "node dist/src/agent/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build:vercel": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/vercel/index.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "spectrum-ts": "^12.10.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module"
}
